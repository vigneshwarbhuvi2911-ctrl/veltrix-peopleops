# ---- Data (defaults point at ./data, which docker-compose mounts into the container) ----
CORPUS_DIR=./data/corpus
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/veltrix.db

# Today's date as YYYY-MM-DD. Leave empty to use the system date.
APP_TODAY=

# ---- LLM ----
# LLM provider (OpenAI Chat Completions API)
LLM_PROVIDER=openai
# Optional model override (default: gpt-4.1)
LLM_MODEL=
# Per-call timeout; two calls per message must fit in the 30 s request limit.
LLM_TIMEOUT_SECONDS=12
# Optional: override the provider base URL (e.g. a proxy or gateway)
LLM_BASE_URL=

# API key. Never commit a real key.
OPENAI_API_KEY=

# ---- Retrieval ----
# Corpus tokens (cl100k_base) packed into one LLM call. Hard limit enforced in code is 3000.
CORPUS_TOKEN_BUDGET=2800
# Where the built index is written (inside the container by default, never in ./data)
INDEX_PATH=./.index/index.json
OCR_LANG=eng

# ---- Logging ----
LOG_LEVEL=INFO
# Optional file in addition to stdout
LOG_FILE=
